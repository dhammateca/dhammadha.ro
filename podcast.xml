---
layout: null
permalink: /podcast.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:itunes="http://www.itunes.com/dtds/podcast-1.0.dtd" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ site.podcast.title | xml_escape }}</title>
    <link>{{ '/' | absolute_url | xml_escape }}</link>
    <description>{{ site.podcast.description | xml_escape }}</description>
    <language>{{ site.podcast.language | xml_escape }}</language>
    <itunes:author>{{ site.podcast.author | xml_escape }}</itunes:author>
    <itunes:summary>{{ site.podcast.description | xml_escape }}</itunes:summary>
    <itunes:explicit>{{ site.podcast.explicit }}</itunes:explicit>
    {% if site.podcast.image %}<itunes:image href="{{ site.podcast.image | absolute_url | xml_escape }}" />{% endif %}
    {% assign dated_recordings = site.data.dhammapada_audio | where_exp: 'recording', 'recording.date' %}
    {% if dated_recordings.size == site.data.dhammapada_audio.size %}
      {% assign recordings = dated_recordings | sort: 'date' | reverse %}
    {% else %}
      {% assign recordings = site.data.dhammapada_audio %}
    {% endif %}
    {% for recording in recordings %}
      {% if recording.audio and recording.audio_length and recording.audio_guid %}
        {% assign chapter_document = nil %}
        {% capture chapter_marker %}_kn_dhp/{{ recording.chapter }}-{% endcapture %}
        {% for document in site.kn_dhp %}
          {% if document.path contains chapter_marker %}
            {% assign chapter_document = document %}
            {% break %}
          {% endif %}
        {% endfor %}
        {% if chapter_document %}
          {% assign chapter_number = recording.chapter | plus: 0 %}
          {% assign verse_number = recording.verse | plus: 0 %}
          {% capture episode_path %}{{ chapter_document.url }}#dhp-{{ recording.chapter }}-{{ recording.verse }}{% endcapture %}
          <item>
            <title>Dhammapada {{ chapter_number }}.{{ verse_number }} - {{ chapter_document.title | xml_escape }}</title>
            <guid isPermaLink="false">{{ recording.audio_guid | xml_escape }}</guid>
            {% if recording.date %}<pubDate>{{ recording.date | date_to_rfc822 }}</pubDate>{% endif %}
            <link>{{ episode_path | absolute_url | xml_escape }}</link>
            <description>{{ site.podcast.title | xml_escape }}, capitolul {{ chapter_number }} - {{ chapter_document.title | xml_escape }}, versul {{ verse_number }}.</description>
            <enclosure url="{% include audio-absolute-url.html audio=recording.audio %}" length="{{ recording.audio_length }}" type="audio/mpeg" />
            {% if recording.audio_duration %}<itunes:duration>{{ recording.audio_duration | xml_escape }}</itunes:duration>{% endif %}
          </item>
        {% endif %}
      {% endif %}
    {% endfor %}
  </channel>
</rss>
